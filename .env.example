# Frontend: safe to expose. Copy from Supabase Project Settings > API.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_EVENT_SLUG=wulin-annual-2026

# Server only: NEVER prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
EVENT_SLUG=wulin-annual-2026
ADMIN_PIN=5678
SESSION_SECRET=replace-with-openssl-rand-base64-48
